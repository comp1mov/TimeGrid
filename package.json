{
  "name": "timegrid",
  "version": "28.35.0-drawing.9",
  "description": "An experimental spatial montage and frame-sampling browser application",
  "scripts": {
    "test": "node --test tests/chrono-animation.test.mjs tests/chrono-compositing.test.mjs tests/drawing-geometry.test.mjs tests/stroke-document.test.mjs tests/drawing-temporal.test.mjs tests/drawing-integration.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prebuild": "node scripts/check-release.cjs",
    "pretest": "node scripts/check-release.cjs",
    "test:drawing": "node tests/drawing-integration.browser.cjs && node tests/drawing-integration-extra.browser.cjs",
    "test:drawing-lab": "node tests/drawing-lab.browser.cjs",
    "build:lab": "node scripts/check-drawing-lab-release.cjs && node scripts/build-drawing-lab.cjs",
    "test:drawing-quality": "node tests/drawing-lab-quality.browser.cjs"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "vite-plugin-singlefile": "^2.0.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "perfect-freehand": "1.2.3"
  }
}
